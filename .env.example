# Actra Configuration (Local-First macOS Agent)
# Copy this file to .env and configure as needed

# Local Ollama Host & Model
ACTRA_OLLAMA_HOST=http://localhost:11434
ACTRA_MODEL_NAME=gemma4:12b-mlx
ACTRA_NUM_CTX=8192

# Agent settings
ACTRA_MAX_RETRIES=3
ACTRA_REQUIRE_CONFIRMATION=true
ACTRA_LOG_LEVEL=INFO

